
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Dashboard Điều Phối — Kohnan Parc Mall</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --paper:#EEF2F1; --panel:#FFFFFF; --panel2:#F5F7F6; --ink:#1C2B33; --ink-soft:#5B6B72; --line:#D7DEDC;
    --steel:#33495A; --safety:#F2661D; --safety-soft:#FDE3D4;
    --leave:#B9821F; --leave-soft:#F8ECD4; --off:#8A97A0; --off-soft:#E7EBEA;
    --ok:#2E7D6B; --ok-soft:#DCEEE8; --night:#4A4EC1; --night-soft:#E4E4FA;
    --sale:#B54708; --sale-soft:#FDF0E4; --admin:#1D5F91; --admin-soft:#E4EEF6;
    --active:#1E8E5A; --active-soft:#DFF3E7;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:'IBM Plex Sans',-apple-system,sans-serif;background:var(--paper);color:var(--ink);}
  .wrap{max-width:1180px;margin:0 auto;padding:22px 20px 60px;}
  .disp{font-family:'Oswald','IBM Plex Sans',sans-serif;letter-spacing:.01em;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  h1,h2,h3{margin:0;}
  button{font-family:inherit;cursor:pointer;}
  input,select{font-family:inherit;}

  .toolbar{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px;margin-bottom:14px;}
  .btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:8px;padding:10px 16px;font-weight:600;font-size:13.5px;}
  .btn-primary{background:var(--safety);color:#fff;}
  .btn-ghost{background:var(--panel2);border:1px solid var(--line);color:var(--ink);}
  .btn-safety{background:var(--safety);color:#fff;}
  .btn-sm{padding:6px 10px;font-size:12.5px;border-radius:7px;}

  .meta{font-size:12px;color:var(--ink-soft);margin-bottom:16px;display:flex;gap:6px;flex-wrap:wrap;}

  .dropzone{border:2px dashed var(--line);border-radius:14px;background:var(--panel);padding:44px 20px;text-align:center;transition:.15s;}
  .dropzone.drag{border-color:var(--safety);background:var(--safety-soft);}
  .dropzone .lbl{font-size:16px;font-weight:600;color:var(--ink);margin-top:8px;}
  .dropzone .sub{font-size:13px;color:var(--ink-soft);margin-top:6px;max-width:420px;margin-left:auto;margin-right:auto;}

  /* ---- Hero ---- */
  .hero{position:relative;overflow:hidden;background:linear-gradient(135deg, #FCE7D6 0%, var(--panel) 55%);border:1px solid var(--line);border-radius:16px;padding:26px 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:16px;}
  .hero::before{content:"";position:absolute;top:-60px;left:-60px;width:220px;height:220px;background:radial-gradient(circle, rgba(242,102,29,0.14), transparent 70%);pointer-events:none;}
  .hero-logo{font-family:'Oswald',sans-serif;font-weight:700;font-size:26px;letter-spacing:.04em;color:var(--safety);}
  .hero-sub{font-size:11.5px;letter-spacing:.12em;color:var(--ink-soft);margin-top:4px;text-transform:uppercase;}
  .hero-right{display:flex;align-items:baseline;gap:14px;text-align:right;}
  .hero-daynum{font-family:'Oswald',sans-serif;font-weight:700;font-size:64px;line-height:1;color:var(--steel);}
  .hero-daymeta{font-size:14px;color:var(--ink-soft);}
  .hero-weekday{color:var(--safety);font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:12.5px;margin-top:2px;}
  .hero-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;justify-content:flex-end;}
  .day-badge{font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-radius:6px;padding:3px 8px;}
  .day-badge.weekend{background:var(--night-soft);color:var(--night);}
  .day-badge.mid{background:var(--admin-soft);color:var(--admin);}
  .day-badge.holiday{background:var(--safety-soft);color:var(--safety);}

  .target-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:16px;}
  .target-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;}
  .target-card .lbl{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);}
  .target-card .val{font-family:'Oswald',sans-serif;font-size:22px;font-weight:700;color:var(--steel);margin-top:2px;}
  .target-card.pretax{border-left:4px solid var(--admin);}
  .target-card.posttax{border-left:4px solid var(--safety);}

  .note-banner{display:flex;align-items:flex-start;gap:10px;background:var(--leave-soft);border:1px solid var(--leave);border-radius:12px;padding:12px 16px;margin-bottom:16px;font-size:13.5px;color:#7A5810;}
  .note-banner .ic{font-size:18px;flex-shrink:0;}
  .note-banner b{font-weight:700;}

  .controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:16px;}
  .navbtn{width:34px;height:34px;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:8px;background:var(--panel2);color:var(--ink);}
  .navbtn:disabled{background:var(--off-soft);color:var(--off);cursor:not-allowed;}
  .dateLabel{font-size:17px;font-weight:600;color:var(--ink);}
  input[type=date],.search-input{border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:13.5px;background:var(--panel2);color:var(--ink);color-scheme:light;}
  .search-wrap{position:relative;flex:1 1 200px;}
  .search-wrap input{width:100%;padding:8px 10px 8px 30px;box-sizing:border-box;border:1px solid var(--line);border-radius:8px;font-size:13.5px;background:var(--panel2);color:var(--ink);}
  .search-wrap svg{position:absolute;left:9px;top:9px;color:var(--ink-soft);}

  /* ---- Stats ---- */
  .stats-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;flex:1;}
  .stat{position:relative;background:var(--panel);border-radius:10px;padding:14px 16px 14px 18px;border-left:4px solid var(--accent,var(--safety));}
  .stat .val{font-size:26px;font-weight:700;color:var(--steel);font-family:'Oswald',sans-serif;}
  .stat .lbl{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin-top:2px;}
  .legend-chip{display:inline-flex;align-items:center;gap:7px;background:var(--panel2);border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:11.5px;color:var(--ink-soft);white-space:nowrap;}
  .legend-chip .tag{background:var(--leave-soft);color:var(--leave);border-radius:6px;padding:2px 6px;font-weight:700;font-size:10.5px;}

  /* ---- Teams ---- */
  .teams{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px;}
  @media(max-width:760px){.teams{grid-template-columns:1fr;}}
  .team-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;}
  .team-head{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 12px;}
  .team-head .name{font-weight:700;font-size:15px;font-family:'Oswald',sans-serif;letter-spacing:.03em;text-transform:uppercase;color:var(--steel);}
  .team-count{font-size:12px;font-weight:600;color:var(--ink-soft);}
  .team-body{padding:0 18px 16px;}

  .shift-group-head{display:flex;align-items:center;gap:8px;font-size:11.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);margin:14px 0 8px;padding-top:12px;border-top:1px solid var(--line);}
  .shift-group:first-child .shift-group-head{border-top:none;padding-top:0;margin-top:0;}
  .shift-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

  .emp-row{position:relative;display:flex;align-items:center;gap:12px;background:var(--panel2);border:1px solid transparent;border-radius:10px;padding:10px 12px;margin-bottom:8px;}
  .emp-row.active{border-color:var(--active);box-shadow:0 0 0 1px var(--active) inset;}
  .emp-time{font-family:'IBM Plex Mono',monospace;font-size:12.5px;font-weight:600;min-width:96px;color:var(--ink-soft);}
  .emp-time.off{color:var(--off);}
  .emp-time .short-badge{display:inline-block;margin-left:5px;background:var(--leave-soft);color:var(--leave);border-radius:5px;padding:1px 5px;font-size:9.5px;font-weight:700;vertical-align:middle;}
  .emp-info{flex:1;min-width:0;}
  .emp-name{font-weight:600;font-size:14px;color:var(--ink);}
  .emp-pos{font-size:11.5px;color:var(--ink-soft);}
  .active-pill{display:inline-flex;align-items:center;gap:4px;color:var(--active);font-size:10.5px;font-weight:700;margin-top:2px;}
  .active-pill .dot{width:6px;height:6px;border-radius:50%;background:var(--active);animation:pulse 1.6s infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
  .emp-actions{flex-shrink:0;position:relative;}
  .phone-btn{width:32px;height:32px;border-radius:50%;border:1px solid var(--line);background:var(--panel);color:var(--ink-soft);display:flex;align-items:center;justify-content:center;font-size:14px;}
  .phone-btn:hover{color:var(--safety);border-color:var(--safety);}
  .phone-pop{position:absolute;right:0;top:38px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:0 8px 20px rgba(28,43,51,0.14);padding:6px;z-index:20;min-width:150px;}
  .phone-pop a{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:7px;font-size:12.5px;color:var(--ink);text-decoration:none;white-space:nowrap;}
  .phone-pop a:hover{background:var(--panel);}
  .empty{padding:30px;text-align:center;color:var(--ink-soft);font-size:13px;}

  .panel-title{display:flex;align-items:center;justify-content:space-between;margin:26px 0 12px;}
  .panel-title h2{font-size:19px;color:var(--ink);}
  .panel-title .actions{display:flex;gap:8px;}

  .task-toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;}
  .task-list{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;}
  .task-row{display:flex;align-items:flex-start;gap:10px;padding:12px 16px;border-top:1px solid var(--line);}
  .task-row:first-child{border-top:none;}
  .task-row.done .task-title{text-decoration:line-through;color:var(--ink-soft);}
  .task-check{width:20px;height:20px;border-radius:5px;border:1.6px solid var(--line);flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;background:var(--panel2);color:var(--ink);}
  .task-check.checked{background:var(--ok);border-color:var(--ok);color:#fff;}
  .task-body{flex:1;min-width:0;}
  .task-title{font-size:13.5px;font-weight:600;color:var(--ink);}
  .task-sub{font-size:11.5px;color:var(--ink-soft);margin-top:2px;display:flex;gap:8px;flex-wrap:wrap;}
  .assignee-pill{background:var(--admin-soft);color:var(--admin);border-radius:999px;padding:2px 9px;font-weight:600;}
  .task-del{background:none;border:none;color:var(--off);padding:4px;border-radius:6px;}
  .task-del:hover{background:var(--off-soft);color:var(--safety);}

  .add-task-form{display:flex;gap:8px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:12px;}
  .add-task-form input[type=text]{flex:2 1 220px;border:1px solid var(--line);border-radius:8px;padding:9px 11px;font-size:13.5px;background:var(--panel2);color:var(--ink);}
  .add-task-form select{flex:1 1 140px;border:1px solid var(--line);border-radius:8px;padding:9px 11px;font-size:13.5px;background:var(--panel2);color:var(--ink);}

  .banner{display:flex;align-items:flex-start;gap:10px;border-radius:10px;padding:12px;font-size:13.5px;margin-bottom:14px;}
  .banner.warn{background:var(--safety-soft);border:1px solid var(--safety);color:#8A3512;}
  .banner.info{background:var(--admin-soft);border:1px solid var(--admin);color:var(--admin);}
  .banner button{background:none;border:none;color:inherit;}

  .footer-note{font-size:11.5px;color:var(--ink-soft);text-align:center;margin-top:30px;}

  @media print{
    .no-print{display:none !important;}
    body{background:#fff;color:#000;}
    .dropzone{display:none;}
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="toolbar no-print">
    <button class="btn btn-ghost" onclick="window.print()">🖨️ In trang</button>
    <button class="btn btn-ghost" id="btnResetData" title="Xóa toàn bộ dữ liệu lịch & công việc đã lưu trong trình duyệt">🗑️ Xóa dữ liệu đã lưu</button>
    <button class="btn btn-primary" id="btnPickSchedule">⬆️ Tải file lịch ca</button>
  </div>

  <div class="hero">
    <div>
      <div class="hero-logo">KOHNAN</div>
      <div class="hero-sub">Parc Mall · Lịch trực <span id="heroWhen">hôm nay</span></div>
    </div>
    <div class="hero-right">
      <div class="hero-daynum" id="heroDayNum">—</div>
      <div>
        <div class="hero-daymeta" id="heroMonthYear">—</div>
        <div class="hero-weekday" id="heroWeekday">—</div>
        <div class="hero-badges" id="heroBadges"></div>
      </div>
    </div>
  </div>

  <div class="meta" id="scheduleMeta"></div>

  <div id="targetStrip" class="target-strip" style="display:none;"></div>
  <div id="noteBanner"></div>

  <input type="file" id="scheduleFile" accept=".xlsx,.xls" style="display:none" />
  <input type="file" id="taskFile" accept=".xlsx,.xls,.csv" style="display:none" />

  <div id="scheduleUploadZone" class="dropzone no-print" style="cursor:pointer;">
    <div style="font-size:30px;color:var(--safety);">⬆️</div>
    <div class="lbl">Kéo thả hoặc bấm để tải file lịch làm việc (.xlsx)</div>
    <div class="sub">Dữ liệu (kèm số điện thoại nếu file có sheet thông tin nhân viên) sẽ được lưu ngay trên trình duyệt này — lần sau mở lại không cần tải lại, trừ khi có lịch tháng mới.</div>
  </div>

  <div id="scheduleApp" style="display:none;">

    <div class="controls no-print">
      <button class="navbtn" id="prevDay" aria-label="Ngày trước">‹</button>
      <div style="display:flex;align-items:center;gap:10px;flex:1 1 220px;">
        <span style="font-size:18px;">📅</span>
        <div class="dateLabel disp" id="dateLabel">—</div>
      </div>
      <input type="date" id="datePicker" class="mono" />
      <button class="btn btn-ghost btn-sm" id="btnToday">Hôm nay</button>
      <button class="navbtn" id="nextDay" aria-label="Ngày sau">›</button>
      <div class="search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="searchBox" placeholder="Tìm theo tên nhân viên..." />
      </div>
    </div>

    <div class="stats-row">
      <div class="stats" id="statsRow"></div>
      <div class="legend-chip"><span class="tag">4h</span> = ca dưới 8 tiếng</div>
    </div>

    <div class="teams" id="teamsBox"></div>
  </div>

  <div class="panel-title">
    <h2 class="disp">Công việc hôm nay — phân công &amp; điều phối</h2>
    <div class="actions no-print">
      <button class="btn btn-ghost btn-sm" id="btnPickTasks">⬆️ Tải file công việc</button>
    </div>
  </div>

  <div id="taskBanner"></div>

  <div class="add-task-form no-print">
    <input type="text" id="newTaskTitle" placeholder="Nhập việc cần làm hôm nay..." />
    <select id="newTaskAssignee"><option value="">— Chưa phân công —</option></select>
    <button class="btn btn-safety" id="btnAddTask">+ Thêm việc</button>
  </div>

  <div class="task-list" id="taskList"></div>

  <div class="footer-note">Dữ liệu lịch ca &amp; công việc được lưu cục bộ trên trình duyệt đang mở file này. Mở file trên máy/trình duyệt khác sẽ không thấy dữ liệu đã lưu — hãy tải lại file lịch nếu cần.</div>

</div>

<script>
/* ============================================================ Utilities */
const $ = (sel) => document.querySelector(sel);
const WEEKDAYS_VI = ["Chủ Nhật","Thứ Hai","Thứ Ba","Thứ Tư","Thứ Năm","Thứ Sáu","Thứ Bảy"];
const MONTHS_VI = ["Tháng 1","Tháng 2","Tháng 3","Tháng 4","Tháng 5","Tháng 6","Tháng 7","Tháng 8","Tháng 9","Tháng 10","Tháng 11","Tháng 12"];

function pad2(n){ return String(n).padStart(2,"0"); }
// Robust, deterministic Excel-serial-number → ISO date conversion (SheetJS's own published
// algorithm). We deliberately do NOT rely on the library's automatic "cellDates" Date-object
// construction, because whether a given cell is recognized as a date depends on that cell's
// number-format metadata — and formula cells (e.g. a header cell containing "=E3") can carry
// different formatting than the literal date cell they reference, causing some date columns to
// be silently mis-typed. Reading the raw numeric serial and converting it ourselves sidesteps
// that entirely and always gives the exact date written in the spreadsheet.
function excelSerialToIso(serial){
  const utcDays = Math.floor(serial - 25569);
  const d = new Date(utcDays * 86400 * 1000);
  return `${d.getUTCFullYear()}-${pad2(d.getUTCMonth()+1)}-${pad2(d.getUTCDate())}`;
}
function looksLikeDateSerial(v){
  // Excel date serials for any real-world roster date comfortably fall in this range
  // (roughly the years 2000–2100). Guards against stray numeric shift-codes etc.
  return typeof v === "number" && v > 36526 && v < 73415;
}
// "Today" must reflect the user's real wall-clock date, so this one intentionally uses LOCAL getters.
function todayIso(){
  const d = new Date();
  return `${d.getFullYear()}-${pad2(d.getMonth()+1)}-${pad2(d.getDate())}`;
}

function classifyShift(raw){
  const s = String(raw||"").trim();
  const upper = s.toUpperCase();
  const m = s.match(/(\d{1,2}):(\d{2})\s*[~\-]\s*(\d{1,2}):(\d{2})/);
  if(m){
    const startH = parseInt(m[1],10) + parseInt(m[2],10)/60;
    const endHraw = parseInt(m[3],10) + parseInt(m[4],10)/60;
    const overnight = endHraw <= startH;
    const endH = overnight ? endHraw + 24 : endHraw;
    let bucket = "day";
    if(startH < 6.5 || overnight) bucket = "night";
    else if(startH >= 13.5) bucket = "evening";
    return {kind:"shift", label:s, startH, endH, overnight, bucket};
  }
  if(upper.includes("OFF")) return {kind:"off", label:"OFF"};
  if(upper.startsWith("AL") || upper.includes("NGHỈ PHÉP")) return {kind:"leave", label:s||"AL"};
  if(upper === "PH") return {kind:"leave", label:"Lễ (PH)"};
  if(upper === "UP") return {kind:"swap", label:"UP"};
  if(upper === "WO") return {kind:"off", label:"WO"};
  return {kind:"note", label:s};
}
const BUCKET_META = {
  night:{color:"var(--night)",soft:"var(--night-soft)",icon:"🌙",name:"Ca đêm"},
  day:{color:"var(--ok)",soft:"var(--ok-soft)",icon:"☀️",name:"Ca sáng"},
  evening:{color:"var(--safety)",soft:"var(--safety-soft)",icon:"🌇",name:"Ca chiều/tối"},
};
function teamOf(position){
  return /sale/i.test(position||"") ? "SALES" : "ADMIN";
}
function nowDecimalHours(){
  const d = new Date();
  return d.getHours() + d.getMinutes()/60;
}
function isShiftActiveNow(c){
  if(selectedDate !== todayIso()) return false;
  const h = nowDecimalHours();
  if(c.overnight) return h >= c.startH || h < (c.endH - 24);
  return h >= c.startH && h < c.endH;
}
function shortShiftBadge(c){
  const dur = c.endH - c.startH;
  return dur > 0 && dur < 7.5 ? `<span class="short-badge">${Math.round(dur)}h</span>` : "";
}

/* ============================================================ Shift-file parser */
function parsePhoneBook(workbook){
  // Look across all sheets for one that has an employee-code column and a phone-number column.
  // Only the phone number is extracted — other personal fields in that sheet (ID numbers,
  // birthdate, address, emergency contact) are intentionally never read.
  const phoneMap = {};
  workbook.SheetNames.forEach(sheetName=>{
    const ws = workbook.Sheets[sheetName];
    const aoa = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
    if(!aoa || aoa.length < 2) return;
    let headerIdx = -1, header = null;
    for(let r=0;r<Math.min(aoa.length,5);r++){
      const row = aoa[r]; if(!row) continue;
      const lower = row.map(h=>String(h||"").toLowerCase());
      const hasCode = lower.some(h=>h.includes("mã nhân viên") || h.includes("ee code") || h.includes("employee code"));
      const hasPhone = lower.some(h=>h.includes("điện thoại") || h.includes("phone"));
      if(hasCode && hasPhone){ headerIdx = r; header = lower; break; }
    }
    if(headerIdx===-1) return;
    const codeCol = header.findIndex(h=>h.includes("mã nhân viên") || h.includes("ee code") || h.includes("employee code"));
    // Prefer a column literally named "số điện thoại" over "số điện thoại người thân" (emergency contact).
    let phoneCol = header.findIndex(h=>h.includes("điện thoại") && !h.includes("người thân") && !h.includes("khẩn cấp"));
    if(phoneCol===-1) phoneCol = header.findIndex(h=>h.includes("điện thoại") || h.includes("phone"));
    if(codeCol===-1 || phoneCol===-1) return;
    for(let r=headerIdx+1;r<aoa.length;r++){
      const row = aoa[r]; if(!row) continue;
      const code = row[codeCol];
      const phone = row[phoneCol];
      if(code===null||code===undefined||code==="") continue;
      if(phone===null||phone===undefined||phone==="") continue;
      phoneMap[String(code).trim()] = String(phone).trim();
    }
  });
  return phoneMap;
}
function formatPhone(raw){
  // Excel often strips the leading 0 from a Vietnamese mobile number when it's stored as a
  // number. Re-add it so the number is dialable.
  let digits = String(raw||"").replace(/\D/g,"");
  if(digits.length===9) digits = "0"+digits;
  if(!/^0\d{9}$/.test(digits)) return null;
  return digits;
}
function phoneActionsHtml(phone){
