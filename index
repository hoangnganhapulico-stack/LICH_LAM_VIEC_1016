    if(groups.off.length>0){
      body += `<div class="shift-group">
        <div class="shift-group-head"><span class="shift-dot" style="background:var(--off)"></span>Nghỉ · ${groups.off.length}</div>
        ${groups.off.map(({r,c})=>empRowHtml(r,c,true)).join("")}
      </div>`;
    }
    return `<div class="team-card">
      <div class="team-head"><div class="name">${title}</div><div class="team-count">${list.length} người</div></div>
      <div class="team-body">${body}</div>
