/* ============================================================ Lenient task-file parser */
function parseTaskWorkbook(workbook, opts){
  const auto = !!(opts && opts.auto);
  let added = 0, targetIso = selectedDate;
  workbook.SheetNames.forEach(sheetName=>{
    const ws = workbook.Sheets[sheetName];
    const aoa = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
    if(!aoa || aoa.length < 2) return;
    // find header row: first row with >=2 non-empty string cells
    let headerIdx = -1;
    for(let r=0;r<Math.min(aoa.length,10);r++){
      const row = aoa[r]; if(!row) continue;
      const strCells = row.filter(c=>typeof c==="string" && c.trim()).length;
      if(strCells>=2){ headerIdx=r; break; }
    }
    if(headerIdx===-1) return;
    const header = aoa[headerIdx].map(h=>String(h||"").toLowerCase());
    const findCol = (keywords) => header.findIndex(h=>keywords.some(k=>h.includes(k)));
    const dateCol = findCol(["ngày","date"]);
    const titleCol = findCol(["công việc","nội dung","title","task","tên việc"]);
    const assigneeCol = findCol(["phụ trách","người","assignee","nhân viên"]);
    if(titleCol===-1) return; // can't use this sheet
    for(let r=headerIdx+1;r<aoa.length;r++){
      const row = aoa[r]; if(!row) continue;
      const title = row[titleCol];
      if(typeof title !== "string" || !title.trim()) continue;
      let iso = targetIso;
      if(dateCol!==-1 && looksLikeDateSerial(row[dateCol])) iso = excelSerialToIso(row[dateCol]);
      const assignee = assigneeCol!==-1 ? (row[assigneeCol]||"") : "";
      if(!tasksStore[iso]) tasksStore[iso] = [];
      tasksStore[iso].push({id:"t"+Date.now()+Math.random().toString(36).slice(2,7), title:title.trim(), assignee:String(assignee||"").trim(), done:false, source: sheetName, _auto: auto});
      added++;
    }
  });
  return added;
}

// Re-syncs tasks from a "CÔNG VIỆC"-style sheet bundled in the main schedule workbook.
// Previously auto-imported tasks are cleared first so re-uploading the same file doesn't
// duplicate entries; tasks the user added by hand are always left untouched.
function autoImportBundledTasks(workbook){
  Object.keys(tasksStore).forEach(iso=>{
    tasksStore[iso] = (tasksStore[iso]||[]).filter(t=>!t._auto);
  });
  const added = parseTaskWorkbook(workbook, {auto:true});
  persistTasks();
  return added;
}

/* ============================================================ Event wiring */
function showBanner(target, type, html){
  target.innerHTML = `<div class="banner ${type}"><div style="flex:1">${html}</div><button data-close="1">✕</button></div>`;
  target.querySelector("[data-close]").onclick = () => target.innerHTML = "";
}

function wireEvents(){
  const scheduleFile = $("#scheduleFile");
  const taskFile = $("#taskFile");

  $("#btnPickSchedule").onclick = () => scheduleFile.click();
  $("#btnResetData").onclick = () => {
    const ls = safeLS();
    if(ls){ ls.removeItem("kb-schedule-data"); ls.removeItem("kb-tasks-data"); }
    scheduleData = null; fileMeta = null; tasksStore = {}; selectedDate = todayIso(); searchTerm = "";
    renderAll();
    showBanner($("#taskBanner"), "info", "Đã xóa toàn bộ dữ liệu đã lưu. Vui lòng tải lại file lịch làm việc.");
  };
  $("#scheduleUploadZone").onclick = () => scheduleFile.click();
  $("#scheduleUploadZone").addEventListener("dragover", e=>{ e.preventDefault(); $("#scheduleUploadZone").classList.add("drag"); });
  $("#scheduleUploadZone").addEventListener("dragleave", ()=> $("#scheduleUploadZone").classList.remove("drag"));
  $("#scheduleUploadZone").addEventListener("drop", e=>{
    e.preventDefault(); $("#scheduleUploadZone").classList.remove("drag");
    if(e.dataTransfer.files.length) handleScheduleFile(e.dataTransfer.files[0]);
  });
  scheduleFile.addEventListener("change", e=>{ if(e.target.files.length) handleScheduleFile(e.target.files[0]); });

  $("#btnPickTasks").onclick = () => taskFile.click();
  taskFile.addEventListener("change", e=>{ if(e.target.files.length) handleTaskFile(e.target.files[0]); });

  $("#prevDay").onclick = () => shiftDay(-1);
  $("#nextDay").onclick = () => shiftDay(1);
  $("#btnToday").onclick = () => {
    const t = todayIso();
    const all = availableDates();
    if(all.includes(t)){ selectedDate = t; renderAll(); }
    else showBanner($("#taskBanner"), "warn", `Hôm nay (${t}) không có trong file lịch đã tải — có thể file chưa cập nhật đến ngày này.`);
  };
  $("#datePicker").addEventListener("change", e=>{ if(e.target.value){ selectedDate = e.target.value; renderAll(); } });
  $("#searchBox").addEventListener("input", e=>{ searchTerm = e.target.value; renderStats(); renderTeams(); });

  $("#btnAddTask").onclick = () => {
    const titleEl = $("#newTaskTitle");
    const title = titleEl.value.trim();
    if(!title) return;
    addTask(title, $("#newTaskAssignee").value, "Thêm thủ công");
    titleEl.value = "";
  };
  $("#newTaskTitle").addEventListener("keydown", e=>{ if(e.key==="Enter") $("#btnAddTask").click(); });

  $("#taskList").addEventListener("click", e=>{
    const btn = e.target.closest("[data-action]");
    if(!btn) return;
    const id = btn.dataset.id;
    const list = tasksStore[selectedDate] || [];
    if(btn.dataset.action==="toggle"){
      const t = list.find(x=>x.id===id); if(t) t.done = !t.done;
    } else if(btn.dataset.action==="delete"){
      tasksStore[selectedDate] = list.filter(x=>x.id!==id);
    }
    persistTasks();
    renderTasks();
  });

  $("#teamsBox").addEventListener("click", e=>{
    const toggleBtn = e.target.closest("[data-phone-toggle]");
    document.querySelectorAll(".phone-pop").forEach(p=>p.remove());
    if(toggleBtn){
      const phone = toggleBtn.dataset.phoneToggle;
      const wrap = toggleBtn.closest(".emp-actions");
      wrap.insertAdjacentHTML("beforeend", phoneActionsHtml(phone));
      e.stopPropagation();
    }
  });
  document.addEventListener("click", e=>{
    if(!e.target.closest("[data-phone-toggle]") && !e.target.closest(".phone-pop")){
      document.querySelectorAll(".phone-pop").forEach(p=>p.remove());
    }
  });
}

function shiftDay(delta){
  const all = availableDates();
  const idx = all.indexOf(selectedDate);
  const next = idx + delta;
  if(next>=0 && next<all.length){ selectedDate = all[next]; renderAll(); }
}

function handleScheduleFile(file){
  const reader = new FileReader();
  reader.onload = (e) => {
    try{
      const wb = XLSX.read(e.target.result, {type:"array"});
      const result = parseWorkbook(wb);
      if(Object.keys(result.dates).length===0){
        showBanner($("#taskBanner"), "warn", "Không tìm thấy dữ liệu lịch làm việc hợp lệ trong file này. Vui lòng kiểm tra lại định dạng file.");
        return;
      }
      scheduleData = result;
      fileMeta = {name:file.name, updatedAt:new Date().toISOString()};
      persistSchedule();
      pickDefaultDate();
      const tasksAdded = autoImportBundledTasks(wb);
      renderAll();
      const extras = [];
      if(Object.keys(result.budget||{}).length>0) extras.push("target doanh số");
      if(Object.keys(result.notes||{}).length>0) extras.push("ghi chú ngày");
      if(tasksAdded>0) extras.push(`${tasksAdded} công việc từ sheet CÔNG VIỆC`);
      if(extras.length>0){
        showBanner($("#taskBanner"), "info", `Đã đọc thêm: ${extras.join(", ")}.`);
      }
      if(dateMismatchNotice){
        showBanner($("#taskBanner"), "warn", dateMismatchNotice);
      }
    }catch(err){
      showBanner($("#taskBanner"), "warn", "Lỗi khi đọc file: " + escapeHtml(err.message||"định dạng không hợp lệ."));
    }
  };
  reader.readAsArrayBuffer(file);
}

function handleTaskFile(file){
  const reader = new FileReader();
  reader.onload = (e) => {
    try{
      const wb = XLSX.read(e.target.result, {type:"array"});
      const added = parseTaskWorkbook(wb);
      persistTasks();
      renderTasks();
      if(added===0){
        showBanner($("#taskBanner"), "warn", "Không đọc được việc nào từ file — hãy đảm bảo file có cột tên việc (ví dụ 'Công việc' / 'Nội dung'), có thể thêm cột 'Ngày' và 'Người phụ trách'.");
      }else{
        showBanner($("#taskBanner"), "info", `Đã thêm ${added} việc từ file "${escapeHtml(file.name)}".`);
      }
    }catch(err){
      showBanner($("#taskBanner"), "warn", "Lỗi khi đọc file công việc: " + escapeHtml(err.message||""));
    }
  };
  reader.readAsArrayBuffer(file);
}

/* ============================================================ Boot */
loadPersisted();
if(scheduleData) pickDefaultDate();
else selectedDate = todayIso();
wireEvents();
renderAll();
if(staleDataCleared){
  showBanner($("#taskBanner"), "info", "Dashboard vừa được cập nhật để sửa lỗi lệch ngày — dữ liệu lịch cũ đã lưu trong trình duyệt đã được xóa tự động. Vui lòng tải lại file lịch làm việc để tiếp tục.");
} else if(dateMismatchNotice){
  showBanner($("#taskBanner"), "warn", dateMismatchNotice);
}
// Keep the "Đang làm" (currently active) badges live without needing a manual refresh.
setInterval(()=>{
  if(scheduleData && selectedDate===todayIso()){ renderStats(); renderTeams(); }
}, 30000);
</script>
