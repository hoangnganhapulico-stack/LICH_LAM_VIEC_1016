        </div>`
      : "";
    return `<div class="emp-row ${active?"active":""}" data-emp="${r._key}">
      ${timeHtml}
      <div class="emp-info">
        <div class="emp-name">${escapeHtml(r.name)}</div>
        <div class="emp-pos">${escapeHtml(r.position)}</div>
        ${active ? `<div class="active-pill"><span class="dot"></span>Đang làm</div>` : ""}
      </div>
      ${actionsHtml}
    </div>`;
  };

  const buildTeamCard = (title, list) => {
    if(list.length===0){
      return `<div class="team-card"><div class="team-head"><div class="name">${title}</div><div class="team-count">0 người</div></div><div class="team-body"><div class="empty">Không có dữ liệu.</div></div></div>`;
    }
    const groups = {day:[], evening:[], night:[], off:[]};
    list.forEach(r=>{
      const c = classifyShift(r.raw);
      if(c.kind==="shift") groups[c.bucket].push({r,c});
      else groups.off.push({r,c});
    });
    let body = "";
    [["day","Ca sáng"],["evening","Ca chiều/tối"],["night","Ca đêm"]].forEach(([key,label])=>{
      const g = groups[key];
      if(g.length===0) return;
      const meta = BUCKET_META[key];
      body += `<div class="shift-group">
        <div class="shift-group-head"><span class="shift-dot" style="background:${meta.color}"></span>${label} · ${g.length}</div>
        ${g.map(({r,c})=>empRowHtml(r,c,false)).join("")}
      </div>`;
