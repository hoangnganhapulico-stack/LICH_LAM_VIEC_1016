  </div>`;
}

function parseBudget(workbook){
  // Layout: repeating 5-column blocks [date, date-dup, pre-tax total, post-tax total, spacer],
  // one block per month, side by side. We detect blocks by scanning for columns where most
  // cells (down the sheet) look like date serials, rather than assuming fixed positions —
  // robust to the sheet being reordered or resized.
  const budget = {};
  const sheetName = workbook.SheetNames.find(n => /budget/i.test(n));
  if(!sheetName) return budget;
  const ws = workbook.Sheets[sheetName];
  const aoa = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
  const numCols = aoa.reduce((m,row)=>Math.max(m, row?row.length:0), 0);
  let c = 0;
  while(c < numCols){
    const dateRows = [];
    for(let r=0;r<aoa.length;r++){
      const row = aoa[r]; if(!row) continue;
      if(looksLikeDateSerial(row[c])) dateRows.push(r);
    }
    if(dateRows.length >= 15){
      dateRows.forEach(r=>{
        const row = aoa[r];
        const pre = row[c+2], post = row[c+3];
        if(typeof pre==="number" || typeof post==="number"){
          const iso = excelSerialToIso(row[c]);
          budget[iso] = {pre: typeof pre==="number"?pre:null, post: typeof post==="number"?post:null};
        }
      });
      c += 5;
    } else {
      c += 1;
    }
  }
  return budget;
}

function parseWorkbook(workbook){
  const dates = {};
  const notes = {}; // iso -> note text
  let sheetsUsed = 0;
  const phoneMap = parsePhoneBook(workbook);
  const budget = parseBudget(workbook);
  workbook.SheetNames.forEach(sheetName=>{
    const ws = workbook.Sheets[sheetName];
    const aoa = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
    if(!aoa || aoa.length < 3) return;
    let dateRowIdx=-1, maxCount=0;
    const scanLimit = Math.min(aoa.length, 20);
    for(let r=0;r<scanLimit;r++){
      const row = aoa[r]; if(!row) continue;
      let cnt=0;
      for(let c=4;c<row.length;c++){ if(looksLikeDateSerial(row[c])) cnt++; }
      if(cnt>maxCount){ maxCount=cnt; dateRowIdx=r; }
    }
    if(dateRowIdx===-1 || maxCount<5) return;
    const dateRow = aoa[dateRowIdx];
    const colDateMap = {};
    for(let c=4;c<dateRow.length;c++){ if(looksLikeDateSerial(dateRow[c])) colDateMap[c]=excelSerialToIso(dateRow[c]); }
    // The row directly above the date header typically carries free-text day notes
    // (e.g. "CHẠY SẢNH", "NGÀY GIẢM 5%"), aligned to the same columns as the dates.
    const notesRowIdx = dateRowIdx - 1;
    if(notesRowIdx >= 0){
      const notesRow = aoa[notesRowIdx];
      Object.entries(colDateMap).forEach(([cKey, iso])=>{
        const c = Number(cKey);
        const val = notesRow[c];
        if(typeof val === "string" && val.trim()) notes[iso] = val.trim().replace(/\n+/g," · ");
      });
    }
    let saw=false;
    for(let r=dateRowIdx+1;r<aoa.length;r++){
      const row = aoa[r]; if(!row) continue;
      const no=row[0], code=row[1], name=row[2], position=row[3];
      if(typeof name !== "string" || !name.trim()) continue;
      const upperName = name.trim().toUpperCase();
      if(["ADMIN","SALES","SC","TOTAL"].includes(upperName)) continue;
      if(typeof no !== "number") continue;
      saw=true;
      Object.entries(colDateMap).forEach(([cKey, iso])=>{
        const c = Number(cKey);
        const val = row[c];
        if(val===null||val===undefined||val==="") return;
        const raw = String(val).trim();
        if(!dates[iso]) dates[iso]=[];
        const key = code+"__"+name;
        // Boundary dates can appear in two adjacent month-sheets. Prefer the later sheet
        // (processed later in workbook order) since it's more likely to hold the final,
        // updated version rather than an earlier draft/spillover copy.
        const existingIdx = dates[iso].findIndex(e=>e._key===key);
        const rec = {no, code, name:name.trim(), position:position||"", raw, _key:key, _sheet:sheetName, phone: phoneMap[String(code).trim()] || null};
        if(existingIdx===-1) dates[iso].push(rec);
        else dates[iso][existingIdx] = rec;
      });
    }
    if(saw) sheetsUsed++;
  });
  return {dates, sheetsUsed, sheetCount: workbook.SheetNames.length, hasPhoneBook: Object.keys(phoneMap).length>0, notes, budget};
}

/* ============================================================ State */
/* Bump this whenever the parsing/date logic changes, so old cached results (parsed with a
   previous, possibly buggy, version of this code) are never silently reused. */
const SCHEMA_VERSION = 6;

let scheduleData = null; // {dates, sheetsUsed, sheetCount}
let fileMeta = null;
let selectedDate = null;
