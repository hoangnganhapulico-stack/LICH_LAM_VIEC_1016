/* ============================================================ Persistence (localStorage — real standalone browser) */
function safeLS(){ try{ return window.localStorage; }catch(e){ return null; } }
function loadPersisted(){
  const ls = safeLS(); if(!ls) return;
  try{
    const raw = ls.getItem("kb-schedule-data");
    if(raw){
      const parsed = JSON.parse(raw);
      if(parsed.version === SCHEMA_VERSION){
        scheduleData = parsed.data;
        fileMeta = {name: parsed.fileName, updatedAt: parsed.updatedAt};
      } else {
        // Stale data from an older (buggy) version of this dashboard — drop it and ask for a fresh upload.
        ls.removeItem("kb-schedule-data");
        staleDataCleared = true;
      }
    }
  }catch(e){}
  try{
    const rawT = ls.getItem("kb-tasks-data");
    if(rawT) tasksStore = JSON.parse(rawT);
  }catch(e){}
}
function persistSchedule(){
  const ls = safeLS(); if(!ls || !scheduleData) return;
  try{ ls.setItem("kb-schedule-data", JSON.stringify({data:scheduleData, fileName:fileMeta.name, updatedAt:fileMeta.updatedAt, version:SCHEMA_VERSION})); }catch(e){}
}
function persistTasks(){
  const ls = safeLS(); if(!ls) return;
  try{ ls.setItem("kb-tasks-data", JSON.stringify(tasksStore)); }catch(e){}
}

