function renderTeams(){
  const recs = dayRecords();
  const admin = recs.filter(r=>teamOf(r.position)==="ADMIN");
  const sale = recs.filter(r=>teamOf(r.position)==="SALES");

  const empRowHtml = (r, c, isOff) => {
    const active = !isOff && isShiftActiveNow(c);
    const timeHtml = isOff
      ? `<div class="emp-time off">${escapeHtml(c.label)}</div>`
      : `<div class="emp-time">${escapeHtml(c.label)}${shortShiftBadge(c)}</div>`;
    const phone = formatPhone(r.phone);
