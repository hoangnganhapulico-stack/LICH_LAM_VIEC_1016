// Fixed-date national holidays only (don't shift year to year). Tết and other lunar-calendar
// holidays (Giỗ Tổ Hùng Vương, etc.) change every year — add them here manually if needed,
// since there's no reliable way to compute the lunar calendar from code alone.
const FIXED_HOLIDAYS = {
  "01-01": "Tết Dương lịch",
  "04-30": "Giải phóng miền Nam",
  "05-01": "Quốc tế Lao động",
  "09-02": "Quốc khánh",
};
// Lunar-calendar holidays whose solar date changes every year, so these are recorded as exact
// dates (not recurring mm-dd) for the specific years given.
const LUNAR_HOLIDAYS = {
  "2027-02-05": "Tết Nguyên Đán",
  "2027-02-06": "Tết Nguyên Đán",
  "2027-02-07": "Tết Nguyên Đán",
  "2027-02-08": "Tết Nguyên Đán",
  "2027-02-09": "Tết Nguyên Đán",
  "2027-04-16": "Giỗ Tổ Hùng Vương",
};
function specialDayTags(iso){
  const d = new Date(iso+"T00:00:00");
  const tags = [];
  const dow = d.getDay();
  if(dow===0 || dow===6) tags.push({cls:"weekend", label:"Cuối tuần"});
  const day = d.getDate();
  if(day===5 || day===20) tags.push({cls:"mid", label:`Ngày ${day}`});
  const mmdd = `${pad2(d.getMonth()+1)}-${pad2(day)}`;
  if(FIXED_HOLIDAYS[mmdd]) tags.push({cls:"holiday", label:FIXED_HOLIDAYS[mmdd]});
  if(LUNAR_HOLIDAYS[iso]) tags.push({cls:"holiday", label:LUNAR_HOLIDAYS[iso]});
  return tags;
}
function formatVnd(n){
  if(typeof n !== "number") return "—";
  return new Intl.NumberFormat("vi-VN").format(Math.round(n)) + "đ";
}

function dayRecords(){
